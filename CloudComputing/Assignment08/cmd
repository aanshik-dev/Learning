docker cp ../big.txt namenode:/tmp/
docker cp ../mapper.py namenode:/tmp/
docker cp ../reducer.py namenode:/tmp/

docker exec -it namenode bash

cd /tmp
hdfs dfs -mkdir -p /user/root/input
hdfs dfs -put -f /tmp/big.txt /user/root/input/

hdfs dfs -rm -r /user/root/output_count

cd /tmp
hadoop jar /opt/hadoop/share/hadoop/tools/lib/hadoop-streaming-3.3.6.jar \
  -files /tmp/mapper.py,/tmp/reducer.py \
  -input /user/root/input/big.txt \
  -output /user/root/output_count \
  -mapper "python3 mapper.py" \
  -reducer "python3 reducer.py"

hdfs dfs -cat /user/root/output_count/part-00000 | head -n 20

