docker compose up -d

"namenode", "datanode", "resourcemanager", "nodemanager" | ForEach-Object {
    docker exec -u 0 -i $_ bash -c "cat << 'EOF' > /etc/yum.repos.d/CentOS-Base.repo
[base]
name=CentOS-7 - Base
baseurl=http://archive.kernel.org/centos-vault/7.9.2009/os/x86_64/
gpgcheck=0

[updates]
name=CentOS-7 - Updates
baseurl=http://archive.kernel.org/centos-vault/7.9.2009/updates/x86_64/
gpgcheck=0

[extras]
name=CentOS-7 - Extras
baseurl=http://archive.kernel.org/centos-vault/7.9.2009/extras/x86_64/
gpgcheck=0
EOF
yum clean all
yum install -y python3"
}

docker cp ../input.txt namenode:/tmp/
docker cp ../mapper.py namenode:/tmp/
docker cp ../reducer.py namenode:/tmp/

docker exec -it namenode bash
cd /tmp
cat input.txt | python3 mapper.py  
cat input.txt | python3 mapper.py | sort -t',' -k1 | python3 reducer.py | head -n 20


