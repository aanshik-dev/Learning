docker cp ../iris.data namenode:/tmp/
docker cp ../mapper_kmeans.py namenode:/tmp/
docker cp ../reducer_kmeans.py namenode:/tmp/

docker exec -it namenode bash
cd /tmp

# Upload dataset to HDFS
hdfs dfs -put -f /tmp/iris.data /user/root/input/

# Run K-Means MapReduce Streaming Job
hadoop jar /opt/hadoop/share/hadoop/tools/lib/hadoop-streaming-3.3.6.jar \
  -files /tmp/mapper_kmeans.py,/tmp/reducer_kmeans.py \
  -input /user/root/input/iris.data \
  -output /user/root/output_kmeans \
  -mapper "python3 mapper_kmeans.py" \
  -reducer "python3 reducer_kmeans.py"

# View updated candidate centroids
hdfs dfs -cat /user/root/output_kmeans/part-00000